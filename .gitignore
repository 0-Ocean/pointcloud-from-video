# Local datasets and generated results; retain only standard placeholders.
/data/**
!/data/videos/
!/data/frames/
!/data/filtered/
!/data/videos/.gitkeep
!/data/frames/.gitkeep
!/data/filtered/.gitkeep
/outputs/**
!/outputs/dense/
!/outputs/meshes/
!/outputs/sparse/
!/outputs/dense/.gitkeep
!/outputs/meshes/.gitkeep
!/outputs/sparse/.gitkeep

# Python environments and caches.
/venv/
/.venv/
/env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local secrets, logs and operating-system files.
.env
.env.*
!.env.example
*.log
.DS_Store
Thumbs.db
Desktop.ini
